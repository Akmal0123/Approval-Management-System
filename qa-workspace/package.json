{
  "name": "ams-qa-workspace",
  "version": "1.0.0",
  "description": "Playwright E2E & Integration Testing Workspace for Approval Management System",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:paraf": "playwright test tests/e2e/document-paraf-preview.spec.ts",
    "test:auth": "playwright test tests/e2e/auth.spec.ts",
    "test:approval": "playwright test tests/e2e/approval-flow.spec.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

